{
  "name": "avid-media-composer-mcp",
  "version": "0.2.0",
  "description": "MCP server for source-safe Avid Media Composer project, AVB bin, AAF, ALE, EDL, and media analysis with guarded editing automation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "avid-media-composer-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "python/avid_inspector.py",
    "python/requirements.txt",
    "docs",
    "README.md",
    "llms.txt",
    "CITATION.cff",
    "RESEARCH.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev": "tsx src/index.ts",
    "smoke": "npm run build && node scripts/smoke-built.mjs",
    "smoke:http": "npm run build && node scripts/smoke-http.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:all": "npm test && npm run test:python",
    "python:setup": "python -m pip install -r python/requirements.txt",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:npm:dry-run": "node scripts/publish-npm.mjs --dry-run",
    "check": "npm run typecheck && npm test && npm run test:python && npm run smoke && npm run smoke:http && npm run pack:dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leancoderkavy/avid-media-composer-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/leancoderkavy/avid-media-composer-mcp/issues"
  },
  "homepage": "https://avid-media-composer-mcp.vercel.app/",
  "keywords": [
    "avid",
    "avid-media-composer",
    "media-composer",
    "mcp",
    "model-context-protocol",
    "video-editing",
    "nle",
    "avb",
    "aaf",
    "ale",
    "edl",
    "mxf",
    "post-production",
    "ai-video-editing",
    "automation",
    "avid-automation",
    "media-asset-management",
    "editorial-workflow",
    "claude-mcp",
    "chatgpt-mcp"
  ],
  "author": "Avid Media Composer MCP contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  }
}
