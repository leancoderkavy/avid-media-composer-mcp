# Read access is limited to these roots. Separate multiple roots with the OS path delimiter.
AVID_MCP_ALLOWED_ROOTS=C:\Users\you\Documents\Avid Projects

# Read-only inspection is the default. Add edit only after installing a verified bridge.
AVID_MCP_CAPABILITIES=inspect

# Optional Media Composer Extension bridge mailbox.
# AVID_MCP_BRIDGE_DIR=C:\Users\you\AppData\Local\avid-media-composer-mcp\bridge

# Optional executable overrides.
# AVID_MCP_PYTHON=python
# AVID_MCP_FFPROBE=ffprobe

# Safety and performance limits.
AVID_MCP_MAX_FILES=10000
AVID_MCP_MAX_BINS=100
AVID_MCP_MAX_MEDIA_FILES=100
AVID_MCP_COMMAND_TIMEOUT_MS=30000
