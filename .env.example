# Read access is limited to these roots. Separate multiple roots with the OS path delimiter.
AVID_MCP_ALLOWED_ROOTS=C:\Users\you\Documents\Avid Projects

# Read-only inspection is the default. Add edit only after installing a verified bridge.
AVID_MCP_CAPABILITIES=inspect

# Optional Media Composer Extension bridge mailbox.
# AVID_MCP_BRIDGE_DIR=C:\Users\you\AppData\Local\avid-media-composer-mcp\bridge

# Optional explicit Media Composer executable/app path used by installation discovery.
# AVID_MCP_APPLICATION_PATH=C:\Program Files\Avid\Avid Media Composer\AvidMediaComposer.exe

# Optional executable overrides.
# AVID_MCP_PYTHON=python
# AVID_MCP_FFPROBE=ffprobe

# Safety and performance limits.
AVID_MCP_MAX_FILES=10000
AVID_MCP_MAX_BINS=100
AVID_MCP_MAX_MEDIA_FILES=100
AVID_MCP_COMMAND_TIMEOUT_MS=30000

# Remote Streamable HTTP requires at least 32 random bytes.
# Generate locally, for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MCP_AUTH_TOKEN=

# Independent HTTP quotas prevent public or unauthorized traffic from consuming the
# authenticated MCP request budget. Values are requests per 60-second window.
# AVID_MCP_PUBLIC_RATE_LIMIT_PER_MINUTE=300
# AVID_MCP_UNAUTHORIZED_RATE_LIMIT_PER_MINUTE=30
# AVID_MCP_AUTHENTICATED_RATE_LIMIT_PER_MINUTE=120

# Optional privacy-safe operational telemetry. Without a key, telemetry is a no-op.
# Events include transport, route, status, tool name, outcome, duration, and error code only.
# Prompts, tool arguments/results, paths, media names, tokens, IP addresses, and person
# profiles are never captured.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_DISTINCT_ID=service:avid-media-composer-mcp
