# Optional public PostHog project token, embedded at build time. Never use a personal API key.
# Unset falls back to the leancoderkavy project token in lib/telemetry.ts. Independent of the MCP server's POSTHOG_API_KEY.
# NEXT_PUBLIC_POSTHOG_KEY=
# Only these cloud origins are supported and allowed by vercel.json's CSP.
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EU: https://eu.i.posthog.com
